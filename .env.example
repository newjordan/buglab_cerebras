# Copy to .env and fill in local values.
# Do not commit .env.

# Required for Cerebras.
CEREBRAS_API_KEY=

# Cerebras models change by event/account access. Override this with the model
# assigned by the hackathon if different.
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Optional fallback for plumbing tests only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

